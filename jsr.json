{
  "name": "@scgnkrgll/react-overlord",
  "version": "0.3.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./stack": "./src/stack.ts"
  },
  "publish": {
    "include": [
      "src",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/__tests__"
    ]
  },
  "imports": {
    "react": "npm:react@^19.0.0",
    "@types/react": "npm:@types/react@^19"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  }
}
