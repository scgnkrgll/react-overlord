{
  "name": "react-overlord",
  "version": "0.3.0",
  "description": "Type-safe, headless manager for modals, menus, toasts and other overlays.",
  "license": "MIT",
  "author": "Seçgin Karagülle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scgnkrgll/react-overlord.git"
  },
  "homepage": "https://scgnkrgll.github.io/react-overlord/",
  "bugs": {
    "url": "https://github.com/scgnkrgll/react-overlord/issues"
  },
  "keywords": [
    "react",
    "modal",
    "dialog",
    "overlay",
    "toast",
    "context-menu",
    "drawer",
    "headless",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stack": {
      "import": {
        "types": "./dist/stack.d.ts",
        "default": "./dist/stack.js"
      },
      "require": {
        "types": "./dist/stack.d.cts",
        "default": "./dist/stack.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "lint:pkg": "publint && attw --pack . --profile node16",
    "version": "node scripts/sync-jsr-version.mjs && git add jsr.json",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:pkg"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
